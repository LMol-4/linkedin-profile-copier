{
  "manifest_version": 3,
  "name": "LinkedIn Profile Scraper",
  "version": "0.2.0",
  "description": "Copy a complete LinkedIn profile as clean text without leaving the profile tab.",
  "minimum_chrome_version": "116",
  "permissions": [
    "clipboardWrite",
    "offscreen",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*"
  ],
  "action": {
    "default_title": "LinkedIn Profile Scraper",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/in/*"
      ],
      "js": [
        "src/shared/config.js",
        "src/shared/formatter.js",
        "src/content/profileExtractor.js"
      ],
      "css": [
        "src/content/profileOverlay.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
